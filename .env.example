# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable"

# ─── NextAuth ──────────────────────────────────────────
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="https://fielchat.com"

# ─── Next.js ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://fielchat.com"
NODE_ENV="production"

# ─── OpenRouter API (LLM) ─────────────────────────────
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
OPENROUTER_MODEL="x-ai/grok-4.1-fast"
OPENROUTER_FALLBACK_MODELS="anthropic/claude-3.5-haiku,openai/gpt-4o-mini"
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-image-preview"
OPENROUTER_CURATION_MODEL=""
OPENROUTER_NEWS_MODEL=""
OPENROUTER_BLOG_MODEL=""
OPENROUTER_MAX_ATTEMPTS_PER_MODEL="1"
OPENROUTER_RETRY_DELAY_MS="1500"

# ─── Asaas (Pagamentos) ───────────────────────────────
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/api/v3
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
ASAAS_API_KEY="your_asaas_api_key"
ASAAS_SUBSCRIPTION_VALUE="56.90"
ASAAS_WEBHOOK_TOKEN="change_this_secret"

# ─── Evolution API (WhatsApp) ─────────────────────────
EVOLUTION_API_URL="https://your-evolution-api.com"
EVOLUTION_API_KEY="your_evolution_api_key"
EVOLUTION_INSTANCE_NAME="fiel-ia-bot"
WHATSAPP_WEBHOOK_URL="https://fielchat.com/api/webhooks/whatsapp"
WHATSAPP_WEBHOOK_DEBUG="false"
WHATSAPP_WEBHOOK_DRY_RUN="false"
WHATSAPP_BOT_SCOPE="group"
WHATSAPP_GROUP_REPLY_MODE="mention"
FIELIA_WHATSAPP_GROUP_ID=""
FIELIA_WHATSAPP_SENDER_JID=""
WHATSAPP_ALLOWED_GROUP_IDS=""
WHATSAPP_FUNNEL_ENABLED="false"

# ─── SMTP (E-mail) ────────────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="suporte@fielchat.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="\"FIEL.IA\" <suporte@fielchat.com>"

# ─── RAG (Knowledge Base) ─────────────────────────────
RAG_INGEST_API_KEY="change_this_secret"

# ─── News / FreshRSS ──────────────────────────────────
NEWS_SYNC_SECRET="change_this_secret"
NEWS_FEEDS=""
NEWS_FEED_ITEM_LIMIT="10"
NEWS_DEFAULT_CATEGORY="Corinthians"
NEWS_REWRITE_USE_AI="true"
NEWS_REWRITE_TONE="informativo e envolvente"
NEWS_REWRITE_TARGET_AUDIENCE="torcedores do Corinthians"
FRESHRSS_URL="https://your-freshrss.com"
FRESHRSS_USER="your_user"
FRESHRSS_PASS="your_pass"
FRESHRSS_CATEGORY_ID="c_2"
FRESHRSS_FEED_FORMAT="rss"
FRESHRSS_FEED_URL=""

# ─── News Curation (AI) ───────────────────────────────
NEWS_CURATION_USE_AI="true"
NEWS_CURATION_LIMIT="3"
NEWS_CURATION_WINDOW_HOURS="48"
NEWS_CURATION_SECRET="change_this_secret"

# ─── Blog ─────────────────────────────────────────────
BLOG_AUTO_GENERATE="false"
BLOG_DEFAULT_TONE="informativo e envolvente"
BLOG_TARGET_AUDIENCE="torcedores do Corinthians"

# ─── Scheduler (Crons internos) ───────────────────────
CRON_ENABLED="true"
CRON_NEWS_SYNC_SCHEDULE="0 */6 * * *"
CRON_NEWS_CURATION_SCHEDULE="30 7 * * *"
CRON_NEWSLETTER_SCHEDULE="0 9 * * *"
CRON_WEEKLY_QUIZ_SCHEDULE="0 8 * * 1"

# ─── Newsletter ───────────────────────────────────────
NEWSLETTER_SECRET="change_this_secret"
NEWSLETTER_NEWS_LIMIT="5"
NEWSLETTER_DELAY_MS="750"

# ─── Quiz ─────────────────────────────────────────────
QUIZ_WEEKLY_POINTS="150"
QUIZ_WEEKLY_QUESTION_COUNT="5"

# ─── JWT (legacy, usar NEXTAUTH_SECRET) ───────────────
JWT_SECRET="change_this_secret"
