# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fielia?schema=public"

# OpenRouter API Key for LLM
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# OpenRouter model configuration (optional)
# Tip: free models can be rate-limited upstream; set a paid model or provide fallbacks.
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"
OPENROUTER_FALLBACK_MODELS=""
OPENROUTER_MAX_ATTEMPTS_PER_MODEL="1"
OPENROUTER_RETRY_DELAY_MS="1500"
OPENROUTER_IMAGE_MODEL="google/gemini-2.0-nanobanana"

# Evolution API for WhatsApp
EVOLUTION_API_URL="https://your-evolution-api-url.com"
EVOLUTION_API_KEY="your_evolution_api_key_here"
EVOLUTION_INSTANCE_NAME="fiel-ia-bot"

# WhatsApp webhook (optional)
WHATSAPP_WEBHOOK_URL="https://your-app-url.com/api/webhooks/whatsapp"
WHATSAPP_WEBHOOK_DEBUG="false"

# Newsletter (premium only)
NEWSLETTER_SECRET="change_this_secret"
NEWSLETTER_NEWS_LIMIT="5"
NEWSLETTER_DELAY_MS="750"

# News sync (RSS / FreshRSS)
NEWS_SYNC_SECRET="change_this_secret"
NEWS_FEEDS="https://your-feed-1.xml,https://your-feed-2.xml"
NEWS_FEED_ITEM_LIMIT="5"
NEWS_DEFAULT_CATEGORY="Geral"

# JWT Secret for Authentication
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
