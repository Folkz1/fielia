# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=""

# OpenRouter API Key for LLM
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# OpenRouter model configuration (optional)
# Tip: free models can be rate-limited upstream; set a paid model or provide fallbacks.
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"
OPENROUTER_FALLBACK_MODELS=""
OPENROUTER_MAX_ATTEMPTS_PER_MODEL="1"
OPENROUTER_RETRY_DELAY_MS="1500"
OPENROUTER_IMAGE_MODEL="google/gemini-2.0-nanobanana"
OPENROUTER_CURATION_MODEL=""

# Evolution API for WhatsApp
EVOLUTION_API_URL="https://your-evolution-api-url.com"
EVOLUTION_API_KEY="your_evolution_api_key_here"
EVOLUTION_INSTANCE_NAME="fiel-ia-bot"

# WhatsApp webhook (optional)
WHATSAPP_WEBHOOK_URL="https://your-app-url.com/api/webhooks/whatsapp"
WHATSAPP_WEBHOOK_DEBUG="false"

# Newsletter (premium only)
NEWSLETTER_SECRET="change_this_secret"
NEWSLETTER_NEWS_LIMIT="5"
NEWSLETTER_DELAY_MS="750"

# News sync (RSS / FreshRSS)
NEWS_SYNC_SECRET="change_this_secret"
NEWS_FEEDS="https://your-feed-1.xml,https://your-feed-2.xml"
NEWS_FEED_ITEM_LIMIT="5"
NEWS_DEFAULT_CATEGORY="Geral"
FRESHRSS_URL="https://your-freshrss-host"
FRESHRSS_USER="your_freshrss_user"
FRESHRSS_PASS="your_freshrss_password"
FRESHRSS_CATEGORY_ID="c_2"
FRESHRSS_FEED_FORMAT="rss"
FRESHRSS_FEED_URL=""

# News curation (AI)
NEWS_CURATION_USE_AI="true"
NEWS_CURATION_LIMIT="3"
NEWS_CURATION_WINDOW_HOURS="48"
NEWS_CURATION_SECRET="change_this_secret"

# Internal scheduler (no external cron)
CRON_ENABLED="true"
CRON_NEWS_SYNC_SCHEDULE="0 */6 * * *"
CRON_NEWS_CURATION_SCHEDULE="30 7 * * *"
CRON_NEWSLETTER_SCHEDULE="0 9 * * *"

# Weekly quiz
QUIZ_WEEKLY_POINTS="150"

# JWT Secret for Authentication
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments (Asaas - use sandbox for testing)
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
ASAAS_API_KEY="your_asaas_api_key_here"

# Webhook authToken configured in Asaas (sent in header `asaas-access-token`)
ASAAS_WEBHOOK_TOKEN="change_this_secret"
